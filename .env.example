# ============================================================
# VARIABLES DEL MONOLITO InmobiliariaIvan (despliegue en Hetzner)
# Copia este archivo como `.env` y completa los valores.
# La base de datos MySQL sigue en tdbcloud.com (NO la toques).
# ============================================================

# --- Puerto en el host (interno la app escucha en 8081) ---
APP_PORT=8081

# --- BASE DE DATOS MySQL (tdbcloud.com) ---
# Ej: jdbc:mysql://TU_HOST.tdbcloud.com:3306/db_inmobiliaria?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=America/Lima
DB_URL=jdbc:mysql://TU_HOST:3306/db_inmobiliaria?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=America/Lima
DB_USER=TU_USUARIO
DB_PASS=TU_CLAVE

# --- JWT / SEGURIDAD ---
JWT_SECRET=TU_JWT_SECRET
GATEWAY_SECRET=TU_GATEWAY_SECRET

# --- CLOUDINARY ---
CLOUDINARY_CLOUD_NAME=TU_CLOUD
CLOUDINARY_API_KEY=TU_KEY
CLOUDINARY_API_SECRET=TU_SECRET

# --- EMAIL ---
MAIL_USERNAME=tu.correo@gmail.com
MAIL_PASSWORD=tu_app_password

# --- TIPO DE CAMBIO ---
EXCHANGERATE_API_KEY=TU_KEY

# --- MICROSERVICIO SERVICIOS BASICOS (sigue en Render) ---
MS_SERVICIOS_BASICOS_URL=https://tu-microservicio.onrender.com

# --- SUNAT / FACTURACION (APIPERU - IVAN) ---
APISPERU_COMPANY_TOKEN=TU_TOKEN

# --- API SUNAT propia (solo MERRUIC si la instancia se migra; para IVAN dejar vacío) ---
SUNAT_PROVIDER=apisperu
APISUNAT_BASE_URL=https://api-sunat-4c91.onrender.com/api/v1
APISUNAT_API_KEY=
APISUNAT_API_SECRET=

# --- DECOLECTA (RENIEC) ---
DECOLECTA_TOKEN=TU_TOKEN
DECOLECTA_URL=https://decolecta.com/api

# --- WHATSAPP APISPERU ---
WHATSAPP_USERNAME=TU_USUARIO
WHATSAPP_PASSWORD=TU_CLAVE

# --- PIN DE PAGOS ---
PAGO_PIN=TU_PIN

# --- NOTIFICACIONES ---
NOTIFICACION_ADMIN_EMAIL=bytauro2016@gmail.com